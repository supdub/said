set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_VERSION 10.0)
set(CMAKE_SYSTEM_PROCESSOR AMD64)

if(NOT DEFINED ZIG_EXECUTABLE)
    find_program(ZIG_EXECUTABLE zig REQUIRED)
endif()
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ZIG_EXECUTABLE VOICEKEY_WINDRES)

set(CMAKE_C_COMPILER "${ZIG_EXECUTABLE}" CACHE FILEPATH "")
set(CMAKE_C_COMPILER_ARG1 "cc" CACHE STRING "")
set(CMAKE_CXX_COMPILER "${ZIG_EXECUTABLE}" CACHE FILEPATH "")
set(CMAKE_CXX_COMPILER_ARG1 "c++" CACHE STRING "")
if(VOICEKEY_WINDRES)
    set(CMAKE_RC_COMPILER "${VOICEKEY_WINDRES}" CACHE FILEPATH "" FORCE)
    set(CMAKE_RC_COMPILER_ARG1 "" CACHE STRING "" FORCE)
    set(CMAKE_RC_COMPILE_OBJECT
        "<CMAKE_RC_COMPILER> -O coff <DEFINES> <INCLUDES> <FLAGS> <SOURCE> <OBJECT>"
        CACHE STRING "" FORCE)
else()
    find_program(VOICEKEY_WINDRES NAMES x86_64-w64-mingw32-windres)
    if(NOT VOICEKEY_WINDRES)
        message(FATAL_ERROR "The Zig cross-build needs x86_64-w64-mingw32-windres for branded Windows resources.")
    endif()
    set(CMAKE_RC_COMPILER "${VOICEKEY_WINDRES}" CACHE FILEPATH "" FORCE)
endif()

set(VOICEKEY_ZIG_TARGET "x86_64-windows-gnu")
set(CMAKE_C_FLAGS_INIT "-target ${VOICEKEY_ZIG_TARGET}")
set(CMAKE_CXX_FLAGS_INIT "-target ${VOICEKEY_ZIG_TARGET}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-target ${VOICEKEY_ZIG_TARGET}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-target ${VOICEKEY_ZIG_TARGET}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-target ${VOICEKEY_ZIG_TARGET}")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
